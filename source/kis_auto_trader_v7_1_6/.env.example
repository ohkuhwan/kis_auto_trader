# ============================================================
# KIS Auto Trader V7.1.6 - 모의투자 우선 예제 설정
# ============================================================

# ------------------------------------------------------------
# KIS 환경 설정
# 모의투자 검증 중에는 KIS_PAPER=true와 KIS_ENABLE_TRADING=false를 유지하세요.
# 자세한 변수별 동작·기본값·검증 규칙은
# docs/configuration/CONFIGURATION_REFERENCE.md를 참조하세요.
# ------------------------------------------------------------

# [KIS_PAPER] API 환경 선택입니다. true=모의투자 URL/TR, false=실전 URL/TR.
# [설정 메타] 기본값=true; 허용값/형식=true | false
# [주의사항] false는 실전 서버 선택입니다. 모의투자 검증 중 변경하지 마세요.
KIS_PAPER=true

# [KIS_ENABLE_TRADING] 실제 주문 POST 허용 스위치입니다. false=DRY-RUN,
# true=주문 전송 허용.
# [설정 메타] 기본값=false; 허용값/형식=true | false
# [주의사항] true는 주문 POST를 허용합니다. DRY-RUN 이후 모의투자에서만
# 검증하세요.
KIS_ENABLE_TRADING=false

# [KIS_APP_KEY] 현재 KIS_PAPER 환경에서 발급한 App Key입니다. .env에만
# 보관하세요.
# [설정 메타] 기본값=예제 자리표시자(여기에_모의투자_APP_KEY);
# 허용값/형식=문자열(자격증명/비밀정보; 예제 자리표시자는 실제 값으로 교체)
# [주의사항] 실제 값은 .env에만 두고 커밋·공유·로그 출력하지 마세요.
KIS_APP_KEY=여기에_모의투자_APP_KEY

# [KIS_APP_SECRET] 현재 KIS_PAPER 환경에서 발급한 App Secret입니다. .env에만
# 보관하세요.
# [설정 메타] 기본값=예제 자리표시자(여기에_모의투자_APP_SECRET);
# 허용값/형식=문자열(자격증명/비밀정보; 예제 자리표시자는 실제 값으로 교체)
# [주의사항] 실제 값은 .env에만 두고 커밋·공유·로그 출력하지 마세요.
KIS_APP_SECRET=여기에_모의투자_APP_SECRET

# [KIS_HTS_ID] HTS 조건검색 및 체결통보 구독에 사용하는 HTS ID입니다.
# [설정 메타] 기본값=예제 자리표시자(여기에_HTS_ID);
# 허용값/형식=문자열(자격증명/비밀정보; 예제 자리표시자는 실제 값으로 교체)
# [주의사항] 실제 값은 .env에만 두고 커밋·공유·로그 출력하지 마세요.
KIS_HTS_ID=여기에_HTS_ID

# [KIS_CANO] 한국투자증권 계좌번호 앞 8자리입니다.
# [설정 메타] 기본값=예제 자리표시자(계좌번호_앞8자리);
# 허용값/형식=문자열(자격증명/비밀정보; 예제 자리표시자는 실제 값으로 교체)
# [주의사항] 실제 값은 .env에만 두고 커밋·공유·로그 출력하지 마세요.
KIS_CANO=계좌번호_앞8자리

# [KIS_ACNT_PRDT_CD] 계좌 상품 코드입니다. 국내 주식은 일반적으로 01이나 계좌
# 설정을 확인하세요.
# [설정 메타] 기본값=01; 허용값/형식=문자열 또는 숫자; 변수별 설명 및
# config/settings.py 검증 규칙 참조
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_ACNT_PRDT_CD=01


# ------------------------------------------------------------
# 런타임 경로와 파일
# 상대 경로는 프로젝트 루트 기준입니다.
# 경로 변경은 기존 파일을 자동 이전하지 않으므로 먼저 백업하세요.
# 자세한 변수별 동작·기본값·검증 규칙은
# docs/configuration/CONFIGURATION_REFERENCE.md를 참조하세요.
# ------------------------------------------------------------

# [KIS_DATA_DIR] 상태·토큰·주문·휴장일 JSON의 기본 디렉터리입니다. 
# 비우면 json/을 사용합니다.
# [설정 메타] 기본값=json; 허용값/형식=경로: 프로젝트 루트 상대경로 또는
# 절대경로
# [주의사항] 경로 변경은 기존 데이터를 자동 이전하지 않습니다. 변경 전
# 백업하세요.
KIS_DATA_DIR=json

# [MANUAL_STOP_FILE] 수동 정지 표식 경로입니다. 
# 비우면 KIS_DATA_DIR/manual_stop.json을 사용합니다.
# [설정 메타] 기본값=json/manual_stop.json;
# 허용값/형식=경로: 프로젝트 루트 상대경로 또는 절대경로; 빈 값이면 기본 경로
# [주의사항] 경로 변경은 기존 데이터를 자동 이전하지 않습니다. 변경 전
# 백업하세요.
MANUAL_STOP_FILE=json/manual_stop.json

# [START_TRIGGER_FILE] 예약 시작 원인을 전달하는 일회성 표식 경로입니다.
# 비우면 json/start_trigger를 사용합니다.
# [설정 메타] 기본값=json/start_trigger;
# 허용값/형식=경로: 프로젝트 루트 상대경로 또는 절대경로; 빈 값이면 기본 경로
# [주의사항] 경로 변경은 기존 데이터를 자동 이전하지 않습니다. 변경 전
# 백업하세요.
START_TRIGGER_FILE=json/start_trigger

# [KIS_TOKEN_CACHE_FILE] REST 토큰과 WebSocket 접속키 캐시 경로입니다. 
# 비우면 KIS_DATA_DIR/kis_tokens.json을 사용합니다.
# [설정 메타] 기본값=json/kis_tokens.json;
# 허용값/형식=경로: 프로젝트 루트 상대경로 또는 절대경로; 빈 값이면 기본 경로
# [주의사항] 실제 값은 .env에만 두고 커밋·공유·로그 출력하지 마세요.
KIS_TOKEN_CACHE_FILE=json/kis_tokens.json

# [BUILDER_SYMBOLS_FILE] 내부 전략 평가용 종목 코드 목록 파일입니다. 한 줄에
# 종목코드 하나를 입력합니다.
# [설정 메타] 기본값=config/entry_symbols.txt; 
# 허용값/형식=경로: 프로젝트 루트 상대경로 또는 절대경로
# [주의사항] 경로 변경은 기존 데이터를 자동 이전하지 않습니다. 변경 전
# 백업하세요.
BUILDER_SYMBOLS_FILE=config/entry_symbols.txt

# [ENTRY_STRATEGY_FILE] 자체 전략 엔진의 매수 지표/조건 YAML 경로입니다.
# [설정 메타] 기본값=config/my_entry_strategy.kis.yaml; 
# 허용값/형식=경로: 프로젝트 루트 상대경로 또는 절대경로
# [주의사항] 경로 변경은 기존 데이터를 자동 이전하지 않습니다. 변경 전
# 백업하세요.
ENTRY_STRATEGY_FILE=config/my_entry_strategy.kis.yaml

# [EXIT_STRATEGY_FILE] 자체 전략 엔진의 매도 지표/조건 YAML 경로입니다.
# [설정 메타] 기본값=config/my_exit_strategy.kis.yaml;
# 허용값/형식=경로: 프로젝트 루트 상대경로 또는 절대경로
# [주의사항] 경로 변경은 기존 데이터를 자동 이전하지 않습니다. 변경 전
# 백업하세요.
EXIT_STRATEGY_FILE=config/my_exit_strategy.kis.yaml

# [STRATEGY_PROFILES_FILE] 10개 내부 전략의 조합과 프로필을 정의하는 YAML
# 경로입니다.
# [설정 메타] 기본값=config/strategy_profiles.yaml; 
# 허용값/형식=경로: 프로젝트 루트 상대경로 또는 절대경로
# [주의사항] 경로 변경은 기존 데이터를 자동 이전하지 않습니다. 변경 전
# 백업하세요.
STRATEGY_PROFILES_FILE=config/strategy_profiles.yaml

# [STRATEGY_SIGNAL_LOG] 전략별 BUY/HOLD/SELL/ERROR 진단 로그 경로입니다.
# 비우면 logs/strategy_signals.jsonl을 사용합니다.
# [설정 메타] 기본값=logs/strategy_signals.jsonl;
# 허용값/형식=경로: 프로젝트 루트 상대경로 또는 절대경로; 빈 값이면 기본 경로
# [주의사항] 경로 변경은 기존 데이터를 자동 이전하지 않습니다. 변경 전
# 백업하세요.
STRATEGY_SIGNAL_LOG=logs/strategy_signals.jsonl

# [KIS_LOG_DIR] 일자별 운영 로그 및 불명확 주문 감사 백업 디렉터리입니다.
# 기본값 logs. setup.sh 테스트는 별도 임시 경로를 사용합니다.
# [설정 메타] 기본값=logs; 허용값/형식=경로: 프로젝트 루트 상대경로 또는
# 절대경로
# [주의사항] 경로 변경은 기존 데이터를 자동 이전하지 않습니다. 변경 전
# 백업하세요.
KIS_LOG_DIR=logs

# [UNCERTAIN_ORDERS_FILE] 주문 POST 결과가 불명확한 종목의 잠금/감사 JSON
# 경로입니다.
# HTS 주문·체결·미체결·잔고 확인 전 삭제하지 마세요.
# [설정 메타] 기본값=json/uncertain_orders.json;
# 허용값/형식=경로: 프로젝트 루트 상대경로 또는 절대경로; 빈 값이면 기본 경로
# [주의사항] 경로 변경은 기존 데이터를 자동 이전하지 않습니다. 변경 전
# 백업하세요.
UNCERTAIN_ORDERS_FILE=json/uncertain_orders.json

# [CANCEL_ORDERS_FILE] 원주문별 취소 응답/최종 대사 JSON 경로입니다.
# 비우면 KIS_DATA_DIR/cancel_orders.json을 사용합니다.
# 재시작 후에도 취소 이력을 추적하므로 운영 중 삭제하지 말고 업데이트 전에
# 백업하세요.
# [설정 메타] 기본값=json/cancel_orders.json;
# 허용값/형식=경로: 프로젝트 루트 상대경로 또는 절대경로; 빈 값이면 기본 경로
# [주의사항] 경로 변경은 기존 데이터를 자동 이전하지 않습니다. 변경 전
# 백업하세요.
CANCEL_ORDERS_FILE=json/cancel_orders.json

# [STATE_FILE] 포지션, 쿨다운, 일일 거래 및 손익 기준을 저장하는 JSON 파일
# 경로입니다. 비우면 KIS_DATA_DIR/state.json을 사용합니다.
# 재시작/업데이트 전에 백업하세요.
# [설정 메타] 기본값=json/state.json;
# 허용값/형식=경로: 프로젝트 루트 상대경로 또는 절대경로; 빈 값이면 기본 경로
# [주의사항] 경로 변경은 기존 데이터를 자동 이전하지 않습니다. 변경 전
# 백업하세요.
STATE_FILE=json/state.json

# [HOLIDAY_CACHE_FILE] 휴장일 확인 결과를 저장하는 JSON 캐시 파일 경로입니다.
# 기본값은 KIS_DATA_DIR/holiday_config.json입니다. 쓰기 권한을 확인하세요.
# [설정 메타] 기본값=json/holiday_config.json;
# 허용값/형식=경로: 프로젝트 루트 상대경로 또는 절대경로; 빈 값이면 기본 경로
# [주의사항] 경로 변경은 기존 데이터를 자동 이전하지 않습니다. 변경 전
# 백업하세요.
HOLIDAY_CACHE_FILE=json/holiday_config.json

# [KIS_PAPER_HOLIDAY_CALENDAR] 모의투자 휴장일 판단에 사용할 JSON
# 달력경로입니다.
# 비우면 config/krx_holidays_2026.json을 사용합니다.
# [설정 메타] 기본값=config/krx_holidays_2026.json;
# 허용값/형식=경로: 프로젝트 루트 상대경로 또는 절대경로; 빈 값이면 기본 경로
# [주의사항] 경로 변경은 기존 데이터를 자동 이전하지 않습니다. 변경 전
# 백업하세요.
KIS_PAPER_HOLIDAY_CALENDAR=config/krx_holidays_2026.json


# ------------------------------------------------------------
# 진입 후보와 YAML 전략
# HTS 조건검색과 내부 YAML 전략은 별도 후보 경로입니다.
# YAML 수정 후 오프라인 테스트를 수행하세요.
# 자세한 변수별 동작·기본값·검증 규칙은
# docs/configuration/CONFIGURATION_REFERENCE.md를 참조하세요.
# ------------------------------------------------------------

# [ENTRY_MODE] 후보 출처입니다. HTS=조건검색, BUILDER=종목 파일,
# ALL=두 출처의 후보를 합칩니다.
# [설정 메타] 기본값=ALL; 허용값/형식=HTS | BUILDER | ALL
# [주의사항] 후보/파일 변경 후 YAML 검사와 오프라인 회귀 테스트를 수행하세요.
ENTRY_MODE=ALL

# [STRATEGY_EVALUATION_MODE] 후보 종목 평가 엔진입니다.
# KIS10=한투 10개 전략만, CUSTOM=자체 my_entry/my_exit YAML만, ALL=두 엔진 조합.
# ALL 매수는 두 엔진 BUY, 매도는 어느 한 엔진 SELL이면 신호입니다.
# 1차는 SELL 신호+손익률, 2차는 손익률 기준으로 강제 매도합니다.
# [설정 메타] 기본값=ALL; 허용값/형식=KIS10 | CUSTOM | ALL
# [주의사항] ALL 매수=AND, 매도=OR; 1차/2차 손익절은 별도 적용됩니다.
STRATEGY_EVALUATION_MODE=ALL

# [KIS_CONDITION_NAME] HTS에 저장한 단일 조건식 이름입니다. 
# 빈 값이면 해당 검색을 건너뜁니다.
# [설정 메타] 기본값=빈 값(설명에 따라 기본 경로 또는 기능 비활성화);
# 허용값/형식=HTS 저장 조건명 또는 빈 값
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_CONDITION_NAME=

# [KIS_CONDITION_CACHE_TTL_SEC] HTS 조건명 목록의 캐시 시간(초)입니다. 0이면
# 캐시를 사용하지 않습니다.
# [설정 메타] 기본값=60; 허용값/형식=정수 0~600초
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_CONDITION_CACHE_TTL_SEC=60

# [DAILY_BAR_CACHE_TTL_SEC] 동일 종목 일봉 데이터 재사용 최대 시간(초)입니다.
# 기본 300초이며 KIS10/CUSTOM과 보유종목 청산 평가가 같은 snapshot을 공유합니다.
# 코드에서 최소 300초를 적용합니다. 장중 현재가는 실시간 시세를 별도 사용합니다.
# [설정 메타] 기본값=300; 허용값/형식=숫자(초), 코드에서 최소 300초
# [주의사항] 일봉 반영은 최대 5분 늦을 수 있습니다.
# 현재가/위험관리는 실시간 시세로 수행합니다.
DAILY_BAR_CACHE_TTL_SEC=300

# [DAILY_BAR_ERROR_RETRY_SEC] 일봉 API 실패 후 재시도 대기시간입니다.
# 동일 종목의 반복 호출을 억제합니다.
# [설정 메타] 기본값=60; 허용값/형식=숫자(초), 코드에서 최소 15초
# [주의사항] API 오류 반복 호출을 줄입니다.
# 오류 캐시 중 해당 종목 신규 진입 평가는 차단됩니다.
DAILY_BAR_ERROR_RETRY_SEC=60

# [STRATEGY_BUILDER_MAX_SYMBOLS] 한 회차에 평가할 내부 전략 종목 수입니다.
# 일봉 API 호출량에 영향을 줍니다.
# [설정 메타] 기본값=20; 허용값/형식=정수 1~20개
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
STRATEGY_BUILDER_MAX_SYMBOLS=20

# [BUILDER_OBSERVE_ALL_STRATEGIES] 비참여 전략도 진단 평가할지 여부입니다.
# false면 BUY/SELL 참여 전략만 평가하고, true면 등록된 전체 전략도 관찰합니다.
# [설정 메타] 기본값=false; 허용값/형식=true / false
# [주의사항] true는 일봉 조회량을 늘립니다. 전체 관찰은 최대 257일을 요청합니다.
BUILDER_OBSERVE_ALL_STRATEGIES=false


# V7.1.0부터 청산 YAML 사용 여부는 평가 모드가 결정합니다.


# [EXIT_STRATEGY_INTERVAL_SEC] 보유 종목 YAML 청산 조건 재평가 간격(초)입니다.
# [설정 메타] 기본값=60; 허용값/형식=숫자(초); 추가 최소/상한은
# config/settings.py의 검증값 적용
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
EXIT_STRATEGY_INTERVAL_SEC=60


# ------------------------------------------------------------
# 거래 시간 / 시간 설정은 KST 기준입니다.
# 종료 시각 도달은 보유 종목을 자동 매도한다는 뜻이 아닙니다.
# 자세한 변수별 동작·기본값·검증 규칙은
# docs/configuration/CONFIGURATION_REFERENCE.md를 참조하세요.
# ------------------------------------------------------------

# [ENTRY_START_TIME] KST 기준 신규 매수 판단 시작 시각(HH:MM)입니다.
# 거래소 실제 주문 가능 여부와는 별개입니다.
# [설정 메타] 기본값=09:10; 허용값/형식=KST HH:MM, 24시간제
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
ENTRY_START_TIME=09:10

# [ENTRY_END_TIME] KST 기준 신규 매수 판단 종료 시각(HH:MM)입니다.
# 장 마감 동시호가/증권사 정책을 확인해 보수적으로 설정하세요.
# [설정 메타] 기본값=15:10; 허용값/형식=KST HH:MM, 24시간제
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
ENTRY_END_TIME=15:10

# [AUTO_SHUTDOWN_TIME] KST 기준 자동 종료 시각(HH:MM)입니다.
# 미체결 주문 취소 요청과 최종 대사를 수행하지만 보유 주식을 자동 청산하지는
# 않습니다.
# [설정 메타] 기본값=15:10; 허용값/형식=KST HH:MM, 24시간제
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
AUTO_SHUTDOWN_TIME=15:10

# [SELL_START_TIME] KST 기준 매도 주문을 판단할 수 있는 시작 시각(HH:MM)입니다.
# 신규 매수 시간과 독립적입니다.
# [설정 메타] 기본값=09:00; 허용값/형식=KST HH:MM, 24시간제
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
SELL_START_TIME=09:00

# [SELL_END_TIME] KST 기준 매도 주문 판단 종료 시각(HH:MM)입니다.
# 증권사 주문 가능 시간 및 장 마감 정책을 확인하세요.
# [설정 메타] 기본값=15:20; 허용값/형식=KST HH:MM, 24시간제
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
SELL_END_TIME=15:20


# ------------------------------------------------------------
# 위험 한도와 보유 관리
# 이 값들은 프로그램의 진입 제한 기준이며 계좌 전체 손실 한도를 보장하지 습니다.
# 자세한 변수별 동작·기본값·검증 규칙은
# docs/configuration/CONFIGURATION_REFERENCE.md를 참조하세요.
# ------------------------------------------------------------

# [MAX_POSITIONS] 동시에 보유하도록 허용하는 최대 종목 수입니다. 남은 슬롯 수로
# 주문가능 현금을 남은 슬롯 수로 나눠 종목별 예산을 계산합니다.
# 앱 수동 보유 종목도 잔고 대사 후 슬롯에 포함됩니다. 미체결/불명확 매수 예약도
# 보유 슬롯에 반영될 수 있습니다.
# [설정 메타] 기본값=3; 허용값/형식=정수(단위는 변수명/설명 참조)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
MAX_POSITIONS=3

# [ALLOW_ADD_TO_EXISTING_POSITION] 이미 보유한 종목에 추가매수를 허용할지
# 여부입니다.
# 기본 false이며, 예수금 갱신 지연 중 동일 종목 반복 매수/현금 초과를 막기 위해
# false를 권장합니다.
# true로 설정하면 같은 종목 추가매수가 가능하지만 현금·위험 관리 책임은
# 운영자에게 있습니다.
# [설정 메타] 기본값=false; 허용값/형식=true | false
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
ALLOW_ADD_TO_EXISTING_POSITION=false

# [MAX_TRADES_PER_DAY] 일일 최대 매수 거래횟수입니다.
# 실제 매수 첫 체결을 기준으로 집계하며 당일 상태 파일(파일명)을 임의 삭제하지
# 마세요.
# [설정 메타] 기본값=5; 허용값/형식=정수(단위는 변수명/설명 참조)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
MAX_TRADES_PER_DAY=20

# [MAX_DAILY_LOSS_PCT] 일일 손실 한도(%)입니다.
# 한도 도달 시 신규 진입을 제한하는 안전장치이며 손실 방지를 보장하지 않습니다.
# [설정 메타] 기본값=2.0; 허용값/형식=숫자(퍼센트 단위; 예: 2.0은 2%)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
MAX_DAILY_LOSS_PCT=2.0

# [MAX_CANDIDATES] 각 후보 경로에서 평가할 최대 후보 수입니다. 설정 코드에서
# 1~20으로 제한됩니다.
# [설정 메타] 기본값=20; 허용값/형식=정수(단위는 변수명/설명 참조)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
MAX_CANDIDATES=20

# [POSITION_SIZING] true면 주문가능금액과 종목별 조회로 수량을 계산합니다.
# 미수 없는 매수금액/수량(nrcvb_buy_amt/qty)을 추가 상한으로 적용합니다.
# 명시적 현금 부족 거절과 미접수가 확인되면 예수금으로 1회 축소 재계산합니다.
# 필수 현금 필드를 확인할 수 없으면 신규 매수를 차단합니다.
# [설정 메타] 기본값=true; 허용값/형식=true | false 
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
POSITION_SIZING=true

# [KIS_STOP_LOSS_ORDER_MODE] 손절 매도 주문 방식입니다.
# 체결 우선순위와 호가/시세 검증 정책을 함께 고려하세요. 기본 예제는 BEST_LIMIT.
# [설정 메타] 기본값=BEST_LIMIT; 허용값/형식=MARKET | BEST_LIMIT | AUTO
# [주의사항] 위험 기준 변경 후 모의투자에서 검증하세요.
KIS_STOP_LOSS_ORDER_MODE=BEST_LIMIT

# [STOP_LOSS_QUOTE_RETRY_SEC] 손절 주문이 시세/호가 확인 때문에 보류됐을 때
# 재평가할 간격(초)입니다.
# [설정 메타] 기본값=5; 허용값/형식=숫자(초); 추가 최소/상한은
# config/settings.py의 검증값 적용
# [주의사항] 위험 기준 변경 후 모의투자에서 검증하세요.
STOP_LOSS_QUOTE_RETRY_SEC=5

# [EXIT_STOP_LOSS_HARD_PCT] 2차 강제 손절 기준입니다. 전략 신호와 무관합니다.
# 예: 2.0은 평균매입가 대비 -2% 조건을 뜻합니다.
# [설정 메타] 기본값=2.0; 허용값/형식=숫자(퍼센트 단위; 예: 2.0은 2%)
# [주의사항] 위험 기준 변경 후 모의투자에서 검증하세요.
EXIT_STOP_LOSS_HARD_PCT=2.0

# [EXIT_STOP_LOSS_FIRST_PCT] 1차 손절 기준입니다. 전략 SELL도 필요합니다.
# [설정 메타] 기본값=1.5; 허용값/형식=숫자(퍼센트 단위; 1.5는 -1.5%)
# [주의사항] 2차 강제 손절은 EXIT_STOP_LOSS_HARD_PCT이며 별도로 적용됩니다.
EXIT_STOP_LOSS_FIRST_PCT=1.5


# ------------------------------------------------------------
# 주문·체결·대사
# 주문 결과가 불명확하거나 취소가 미확인 상태면 잠금·감사 파일을 삭제하지 말고
# HTS와 대사하세요.
# 자세한 변수별 동작·기본값·검증 규칙은
# docs/configuration/CONFIGURATION_REFERENCE.md를 참조하세요.
# ------------------------------------------------------------

# [SHUTDOWN_CANCEL_CONFIRM_TIMEOUT_SEC] 종료 중 미체결 취소 완료를 확인하기 위해
# 기다리는 최대 시간(초)입니다. 코드 최소값도 180초로 강제합니다.
# 시간 초과 시 주문 상태가 불확실할 수 있으므로 파일을 유지하고 HTS 확인이
# 필요합니다.
# [설정 메타] 기본값=180; 허용값/형식=숫자(초); 코드 최소값 180초
# [주의사항] systemd 종료 유예시간은 300초로 설정합니다.
SHUTDOWN_CANCEL_CONFIRM_TIMEOUT_SEC=180

# [STOP_GRACE_TIMEOUT_SEC] stop.sh가 SIGTERM 이후 종료를 기다립니다.
# [설정 메타] 기본값=240; 허용값/형식=정수 60~240초
# [주의사항] systemd TimeoutStopSec=300초보다 길게 설정하지 않습니다.
# 시간 초과 시 중복 실행을 막고 fail-closed 합니다.
STOP_GRACE_TIMEOUT_SEC=240

# [SHUTDOWN_CANCEL_POLL_SEC] 종료 중 미체결 주문 상태를 다시 조회하는
# 간격(초)입니다.
# 너무 짧으면 API 호출 제한에 걸릴 수 있습니다.
# [설정 메타] 기본값=5; 허용값/형식=숫자(초); 추가 최소/상한은
# config/settings.py의 검증값 적용
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
SHUTDOWN_CANCEL_POLL_SEC=5

# [ORDER_TIMEOUT_SEC] 하위 호환용 공통 타임아웃(초)입니다. 새 BUY/SELL 값이 없을
# 때 매도 기본값이며 매수는 2배입니다.
# [설정 메타] 기본값=60; 허용값/형식=숫자(초); 추가 최소/상한은
# config/settings.py의 검증값 적용
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
ORDER_TIMEOUT_SEC=60

# [BUY_ORDER_TIMEOUT_SEC] 매수 미체결 취소 기준입니다. 최소 300초입니다.
# [설정 메타] 기본값=180; 허용값/형식=숫자(초); 추가 최소/상한은
# config/settings.py의 검증값 적용
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
BUY_ORDER_TIMEOUT_SEC=300

# [SELL_ORDER_TIMEOUT_SEC] 매도 미체결 취소 기준입니다. 최소 300초입니다.
# [설정 메타] 기본값=180; 허용값/형식=숫자(초); 추가 최소/상한은
# config/settings.py의 검증값 적용
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
SELL_ORDER_TIMEOUT_SEC=300

# [ORDER_RECONCILE_INTERVAL_SEC] 미체결 주문 목록과 로컬 pending 상태를
# 대사하는 주기(초)입니다. 취소/부분체결 상태 확정에 사용됩니다.
# [설정 메타] 기본값=20; 허용값/형식=숫자(초); 추가 최소/상한은
# config/settings.py의 검증값 적용
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
ORDER_RECONCILE_INTERVAL_SEC=20

# [UNCERTAIN_RECONCILE_INTERVAL_SEC] 접수 응답이 불명확한 주문을 당일 전체
# 주문/체결내역과 대조하는 주기(초)입니다. 불명확 주문은 자동 재전송하지
# 않습니다.
# [설정 메타] 기본값=60; 허용값/형식=숫자(초); 추가 최소/상한은
# config/settings.py의 검증값 적용
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
UNCERTAIN_RECONCILE_INTERVAL_SEC=60

# [SELL_CANCEL_SETTLE_SEC] 매도 주문 취소 요청 후 잔고/미체결 상태가 갱신될
# 시간을 확보하기 위한 대기시간(초)입니다.
# [설정 메타] 기본값=60; 허용값/형식=숫자(초)
# [주의사항] 취소 응답만으로 재주문하지 않고 REST 대사 후 재평가합니다.
SELL_CANCEL_SETTLE_SEC=60

# [MIN_BUY_ORDER_AMOUNT_KRW] 계산된 신규 매수 주문 금액의 최소 기준(원)입니다.
# 이보다 작으면 주문을 보류합니다. 구버전 MIN_ORDER_AMOUNT_KRW 별칭도
# 지원합니다.
# [설정 메타] 기본값=10000; 허용값/형식=정수(단위는 변수명/설명 참조)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
MIN_BUY_ORDER_AMOUNT_KRW=10000

# [BUY_ORDER_POST_SLEEP_SEC] 매수 주문 접수 후 신규 매수 사이클을 쉬는
# 시간(초)입니다.
# 매도/잔고/주문 대사는 계속 실행됩니다.
# [설정 메타] 기본값=60; 허용값/형식=숫자(초); 추가 최소/상한은
# config/settings.py의 검증값 적용
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
BUY_ORDER_POST_SLEEP_SEC=60

# [ORDER_QTY] POSITION_SIZING=false일 때 사용할 기본 주문 수량(주)입니다.
# POSITION_SIZING=true이면 계산된 수량이 우선합니다.
# [설정 메타] 기본값=1; 허용값/형식=정수(단위는 변수명/설명 참조)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
ORDER_QTY=1

# [KIS_BUY_ORDER_MODE] 매수 주문 방식입니다.
# [설정 메타] 기본값=AUTO; 허용값/형식=MARKET | BEST_LIMIT | AUTO
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_BUY_ORDER_MODE=AUTO

# [KIS_SEL_ORDER_MODE] 일반 매도 주문 방식입니다. 손절 설정과 별도로 적용됩니다.
# [설정 메타] 기본값=BEST_LIMIT; 허용값/형식=MARKET | BEST_LIMIT | AUTO
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_SEL_ORDER_MODE=BEST_LIMIT

# [KIS_SHOW_ORDER_CALCULATION] true면 주문 수량, 추정 가격, 금액, 수수료/세금
# 계산을 로그에 표시합니다.
# 계좌 인증정보는 표시하지 않습니다.
# [설정 메타] 기본값=true; 허용값/형식=true | false
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_SHOW_ORDER_CALCULATION=true


# ------------------------------------------------------------
# 청산 및 손실 관리
# 여러 청산 규칙이 함께 적용될 수 있습니다.
# 시세 지연·호가 부족 시 청산이 지연될 수 있습니다.
# 자세한 변수별 동작·기본값·검증 규칙은
# docs/configuration/CONFIGURATION_REFERENCE.md를 참조하세요.
# ------------------------------------------------------------

# [EXIT_TAKE_PROFIT_FIRST_PCT] 1차 익절 기준입니다. 전략 SELL도 필요합니다.
# [설정 메타] 기본값=1.5; 허용값/형식=숫자(퍼센트 단위; 1.5는 +1.5%)
# [주의사항] 2차 강제 익절은 EXIT_TAKE_PROFIT_HARD_PCT이며 별도로 적용됩니다.
EXIT_TAKE_PROFIT_FIRST_PCT=1.5

# [EXIT_TAKE_PROFIT_HARD_PCT] 2차 강제 익절 기준입니다. 전략 신호와 무관합니다.
# [설정 메타] 기본값=3.0; 허용값/형식=숫자(퍼센트 단위; 예: 2.0은 2%)
# [주의사항] 위험 기준 변경 후 모의투자에서 검증하세요.
EXIT_TAKE_PROFIT_HARD_PCT=3.0

# [KIS_EVENT_EXIT_QUOTE_MAX_AGE_SEC] 실시간 청산 worker가 허용하는 WebSocket
# 시세 최대 나이(초)입니다.
# 오래된 시세로는 주문하지 않고 다음 시세/REST 대사를 기다립니다.
# [설정 메타] 기본값=5; 허용값/형식=숫자(초); 추가 최소/상한은
# config/settings.py의 검증값 적용
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_EVENT_EXIT_QUOTE_MAX_AGE_SEC=5


# ------------------------------------------------------------
# 통합 전략 / 공통 위험 관리
# 두 프로필은 점수·리스크 기준이 다르며 어떤 설정도 수익률이나 승률을 보장하지
# 않습니다.
# 자세한 변수별 동작·기본값·검증 규칙은
# docs/configuration/CONFIGURATION_REFERENCE.md를 참조하세요.
# ------------------------------------------------------------

# V7.1.0: AGG_* 및 STABLE_* 변수는 제거되었습니다. 공통 손익절은 EXIT_*_PCT,
# BUY/SELL 기준은 strategy_profiles.yaml 및 사용자 YAML에서 관리합니다.


# ------------------------------------------------------------
# Telegram 알림
# 알림을 사용하려면 봇 토큰과 수신 채팅 ID를 함께 설정하세요.
# 변수별 설명 및 config/settings.py 검증 규칙 참조
# 선택 설정이며 빈 값이면 Telegram 알림이 비활성화됩니다.
# [주의사항] 실제 값은 .env에만 두고 커밋·공유·로그 출력하지 마세요.
# 자세한 변수별 동작·기본값·검증 규칙은
# docs/configuration/CONFIGURATION_REFERENCE.md를 참조하세요.
# ------------------------------------------------------------

# [TELEGRAM_BOT_TOKEN] 선택 사항인 Telegram Bot API 토큰입니다.
# [설정 메타] 기본값=빈 값; 허용값/형식=Telegram Bot API 토큰 문자열 또는 빈 값
# [주의사항] 실제 토큰은 .env에만 보관하고 커밋·공유·로그 출력하지 마세요.
TELEGRAM_BOT_TOKEN=

# [TELEGRAM_CHAT_ID] 알림을 받을 Telegram 개인/그룹 채팅 ID입니다.
# [설정 메타] 기본값=빈 값; 허용값/형식=채팅 ID 문자열 또는 빈 값
# [주의사항] 봇 토큰과 함께 설정해야 알림을 전송할 수 있습니다.
TELEGRAM_CHAT_ID=


# ------------------------------------------------------------
# 로그와 API 호출 제한
# 프로그램 내부 제한은 KIS 계정의 공식 한도를 대신하지 않습니다.
# EGW00201/EGW00215 발생 시 호출량을 낮추세요.
# 자세한 변수별 동작·기본값·검증 규칙은
# docs/configuration/CONFIGURATION_REFERENCE.md를 참조하세요.
# ------------------------------------------------------------

# [LOG_LEVEL] 로그 상세 수준입니다. DEBUG/INFO/WARNING/ERROR/CRITICAL 중 하나를
# 사용합니다. 운영 기본값은 INFO입니다.
# [설정 메타] 기본값=DEBUG; 허용값/형식=DEBUG | INFO | WARNING | ERROR |
# CRITICAL
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
LOG_LEVEL=DEBUG

# [MAX_CALLS_PER_SEC] 프로그램 내부 REST 호출 제한기의 초당 상한 설정입니다.
# 코드에서 추가 안전상한을 적용하며 KIS 공식 한도를 의미하지 않습니다.
# [설정 메타] 기본값=0.8; 허용값/형식=숫자(초); 추가 최소/상한은
# config/settings.py의 검증값 적용
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
MAX_CALLS_PER_SEC=0.8

# [MAX_CALLS_PER_MIN] 프로그램 내부 REST 호출 제한기의 분당 상한 설정입니다.
# 계정별 실제 KIS 제한을 확인하고 보수적으로 설정하세요.
# [설정 메타] 기본값=40; 허용값/형식=정수(단위는 변수명/설명 참조)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
MAX_CALLS_PER_MIN=40

# [RATE_LIMIT_SAFETY_MARGIN] 내부 호출 상한에 곱하는 여유 비율(0.1~1.0)입니다.
# 0.8은 설정 상한의 80% 수준으로 제한합니다.
# [설정 메타] 기본값=0.80; 허용값/형식=숫자 0.1~1.0
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
RATE_LIMIT_SAFETY_MARGIN=0.80

# [KIS_RATE_LIMIT_COOLDOWN_SEC] 명시적 호출 제한 응답 후 추가 대기 시간(초).
# 기본 10초입니다. KIS의 명시적 호출 제한(EGW00201/EGW00215/HTTP 429) 응답 이후
# REST 요청을 추가로 늦춥니다.
# [설정 메타] 기본값=15; 허용값/형식=숫자(초); 추가 최소/상한은
# config/settings.py의 검증값 적용
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_RATE_LIMIT_COOLDOWN_SEC=15


# ------------------------------------------------------------
# 휴장일 판단
# 임시 휴장일이나 특별 운영일은 별도 확인하세요.
# 판단이 불확실하면 매매 시작을 보류하는 것이 안전합니다.
# 자세한 변수별 동작·기본값·검증 규칙은
# docs/configuration/CONFIGURATION_REFERENCE.md를 참조하세요.
# ------------------------------------------------------------

# [KIS_PAPER_HOLIDAY_FALLBACK] 모의투자 휴장일 API가 지원되지 않을 때의 대체
# 판정입니다.
# WEEKDAY=요일/로컬 달력 기반, STRICT=확실하지 않으면 시작 중단.기본 WEEKDAY는
# 임시 휴장일을 놓칠 수 있습니다.
# [설정 메타] 기본값=WEEKDAY; 허용값/형식=WEEKDAY | STRICT
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_PAPER_HOLIDAY_FALLBACK=WEEKDAY

# [KIS_PAPER_HOLIDAYS] 모의투자 달력에 추가할 임시 휴장일 목록입니다. YYYYMMDD
# 또는 YYYY-MM-DD를 쉼표로 구분합니다.
# [설정 메타] 기본값=빈 값(설명에 따라 기본 경로 또는 기능 비활성화);
# 허용값/형식=문자열 또는 숫자; 변수별 설명 및 config/settings.py 검증 규칙 참조
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_PAPER_HOLIDAYS=


# ------------------------------------------------------------
# Worker와 WebSocket
# 병렬 조회도 공용 호출 제한기를 통과합니다.
# 계정별 구독 한도를 넘지 않도록 보수적으로 설정하세요.
# 자세한 변수별 동작·기본값·검증 규칙은
# docs/configuration/CONFIGURATION_REFERENCE.md를 참조하세요.
# ------------------------------------------------------------

# [BUILDER_EVAL_WORKERS] Builder 후보 일봉 조회/전략 평가의 worker 수입니다.
# 코드에서 1~2로 제한합니다. 병렬 REST 호출도 공용 RateLimiter를 통과합니다.
# [설정 메타] 기본값=2; 허용값/형식=정수 1~2
# [주의사항] 값을 높이면 일봉 조회/API 호출량과 계산량이 증가할 수 있습니다.
BUILDER_EVAL_WORKERS=2

# [EXIT_YAML_EVAL_WORKERS] 보유 종목 YAML 청산 일봉 조회/평가 worker 수입니다.
# 코드에서 1~2로 제한하며 상태 갱신은 main thread에서 수행합니다.
# [설정 메타] 기본값=2; 허용값/형식=정수 1~2
# [주의사항] 값을 높이면 일봉 조회/API 호출량과 계산량이 증가할 수 있습니다.
EXIT_YAML_EVAL_WORKERS=2

# [KIS_WS_MAX_PRICE_SUBSCRIPTIONS] WebSocket 가격 구독 상한입니다.
# 정수 1이상을 사용하며 기본값 30입니다.
# 보유 종목을 우선 구독하고 조건검색 후보는 이 상한 안에서 교체합니다.
# KIS 계정별 구독 제한보다 높게 설정하지 마세요.
# [설정 메타] 기본값=30; 허용값/형식=정수 1 이상
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_WS_MAX_PRICE_SUBSCRIPTIONS=30


# ------------------------------------------------------------
# 기타 런타임 설정
# 변경 전 기본값과 설정 검증 코드를 확인하고 모의투자에서 결과를 검증하세요.
# 추가 최소/상한 및 변수별 설명 은 config/settings.py의 값 적용
# 자세한 변수별 동작·기본값·검증 규칙은
# docs/configuration/CONFIGURATION_REFERENCE.md를 참조하세요.
# ------------------------------------------------------------

# [SCAN_INTERVAL_SEC] HTS/Builder 신규 진입 후보를 재검색하는 간격(초)입니다.
# 짧게 설정하면 API 호출량이 늘어납니다.
# [설정 메타] 기본값=30; 허용값/형식=숫자(초)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
SCAN_INTERVAL_SEC=30

# [BALANCE_INTERVAL_SEC] 잔고 및 포지션을 브로커 응답과 대사하는
# 주기(초)입니다. 재시작 복구와 체결 정합성에 중요합니다.
# [설정 메타] 기본값=60; 허용값/형식=숫자(초)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
BALANCE_INTERVAL_SEC=60

# [UNCERTAIN_AUTO_RESOLVE_MIN_AGE_SEC] 운영자 확인 알림을 판단하는 최소
# 경과시간(초)입니다.
# 이 시간만 지났다고 잠금을 자동 해제하지 않습니다.
# [설정 메타] 기본값=300; 허용값/형식=숫자(초)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
UNCERTAIN_AUTO_RESOLVE_MIN_AGE_SEC=300

# [UNCERTAIN_AUTO_RESOLVE_CHECKS] 불명확 주문 알림을 위한 성공 조회 횟수
# 기준입니다.
# 기준을 충족해도 KIS 내역이 확인되지 않으면 자동 해제하지 않습니다.
# [설정 메타] 기본값=3; 허용값/형식=문자열 또는 숫자
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
UNCERTAIN_AUTO_RESOLVE_CHECKS=3

# [ORPHAN_NOTICE_TTL_SEC] 주문번호의 로컬 pending 등록보다 먼저 도착한
# 체결통보를 보류하는 최대 시간(초)입니다.
# 만료 시에도 주문/잔고 대사는 별도로 필요합니다.
# [설정 메타] 기본값=180; 허용값/형식=숫자(초)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
ORPHAN_NOTICE_TTL_SEC=180

# [UNCERTAIN_TELEGRAM_ALERT_INTERVAL_SEC] 미해결 주문에 대해 Telegram 경고를
# 반복 발송하는 간격(초)입니다.
# Telegram 설정이 필요합니다.
# [설정 메타] 기본값=180; 허용값/형식=숫자(초)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
UNCERTAIN_TELEGRAM_ALERT_INTERVAL_SEC=180

# [QUOTE_STALE_SEC] 캐시 시세를 최신으로 인정하는 최대 나이(초)입니다.
# 오래된 시세로 신규 주문을 결정하지 않도록 보수적으로 설정하세요.
# [설정 메타] 기본값=5; 허용값/형식=숫자(초)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
QUOTE_STALE_SEC=5

# [QUOTE_REST_MIN_INTERVAL_SEC] 같은 종목의 REST 현재가 fallback 요청 사이 최소
# 간격(초)입니다.
# 낮출수록 호출량이 증가합니다.
# [설정 메타] 기본값=5; 허용값/형식=숫자(초)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
QUOTE_REST_MIN_INTERVAL_SEC=5

# [REENTRY_COOLDOWN_SEC] 포지션 청산 후 동일 종목 재진입을 제한하는 시간입니다.
# [설정 메타] 기본값=30000; 허용값/형식=정수 초(코드 최소 30000초)
# [주의사항] 청산 직후 재매수 반복을 줄이는 공통 제한입니다.
REENTRY_COOLDOWN_SEC=30000

# [SELL_RETRY_COOLDOWN_SEC] 매도 실패/취소 후 같은 종목 재평가 전 최소
# 대기시간(초)입니다. 반복 취소·재주문을 줄이기 위해 60초를 권장합니다.
# [설정 메타] 기본값=60; 허용값/형식=숫자(초)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
SELL_RETRY_COOLDOWN_SEC=60

# [SELL_RETRY_MAX_BACKOFF_SEC] 반복 취소 SELL의 지수형 최대 대기시간입니다.
# [설정 메타] 기본값=900; 허용값/형식=숫자(초)
# [주의사항] 반복 취소·재주문을 완화합니다. 재시도는 영구 차단하지 않습니다.
SELL_RETRY_MAX_BACKOFF_SEC=900

# [SELL_NO_BALANCE_RETRY_SEC] KIS가 잔고 없음/주문가능수량 부족을 명시 거절했을
# 때 적용하는 재시도 최소 대기시간(초)입니다.
# [설정 메타] 기본값=30; 허용값/형식=숫자(초)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
SELL_NO_BALANCE_RETRY_SEC=30

# [ENTRY_MAX_DAILY_CHANGE_PCT] 이 값 이상 상승한 종목은 매수 제외.
# [설정 메타] 기본값=25; 허용값/형식=0보다 큰 숫자(%)
# [주의사항] 전일 종가 대비 기준이며, 보유 종목 매도에는 미적용.
ENTRY_MAX_DAILY_CHANGE_PCT=25

# [ENTRY_MIN_DAILY_CHANGE_PCT] 이 값 이하 하락한 종목은 매수 제외.
# [설정 메타] 기본값=-15; 허용값/형식=0보다 작은 숫자(%)
# [주의사항] 전일 종가 대비 등락률입니다. 조회 실패 시 신규 매수는 보류합니다.
ENTRY_MIN_DAILY_CHANGE_PCT=-15

# [KIS_TR_RATE_LIMITS_JSON] KIS TR별 별도 호출 제한(JSON).
# 예: {"FHKST03010100":{"per_sec":0.5,"per_min":20}}
# [설정 메타] 기본값={}; 허용값/형식=JSON 객체, TR ID별 per_sec/per_min 양수
# [주의사항] 주요 국내주식 TR 제한이 내장되어 있습니다.
# 이 JSON은 기본값을 덮어씁니다.
# 수치는 KIS 공식 한도가 아닌 내부 안전 상한입니다.
KIS_TR_RATE_LIMITS_JSON={}

# [MIN_STOCK_PRICE_KRW] 후보 1주 가격 하한(원)입니다.
# 0이면 필터 비활성화, 0보다 크면 현재가가 하한 미만인 종목을 제외합니다.
# [설정 메타] 기본값=0; 허용값/형식=문자열 또는 숫자
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
MIN_STOCK_PRICE_KRW=0

# [BLOCK_NEW_BUY_WHILE_PENDING_BUY] true면 미체결/부분체결/불명확 매수 주문이
# 있는 동안 다른 종목의 신규 매수를 차단합니다.
# 중복 매수 위험을 줄입니다.
# [설정 메타] 기본값=true; 허용값/형식=true | false
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
BLOCK_NEW_BUY_WHILE_PENDING_BUY=true

# [KIS_AUTO_SELECTED_MODE] AUTO가 급격한 변동 조건에 해당하지 않을 때 선택할
# 실제 방식입니다.
# [설정 메타] 기본값=BEST_LIMIT; 허용값/형식=MARKET | BEST_LIMIT
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_AUTO_SELECTED_MODE=BEST_LIMIT

# [KIS_AUTO_PRICE_MOVE_THRESHOLD_PCT] AUTO에서 기준가 대비 절대 변동률이 이값(%)
# 이상이면
# 추격 위험으로 매수를 보류하거나 매도 모드를 변경하는 임계값입니다.
# [설정 메타] 기본값=1.0; 허용값/형식=숫자(퍼센트 단위; 예: 2.0은 2%)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_AUTO_PRICE_MOVE_THRESHOLD_PCT=1.0

# [KIS_MARKET_PRICE_BUFFER_PCT] 시장가 매수 수량 산정에 더하는 가격 상승
# 여유율(%)입니다.
# 체결가격을 보장하는 값이 아닙니다.
# [설정 메타] 기본값=1.0; 허용값/형식=숫자(퍼센트 단위; 예: 2.0은 2%)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_MARKET_PRICE_BUFFER_PCT=1.0

# [KIS_FEE_RATE_PCT] 손익/예산 추정에 적용하는 매수·매도 수수료율(%)입니다.
# 예시 0.02는 0.02%이며 실제 계좌 요율을 확인하세요.
# [설정 메타] 기본값=0.02; 허용값/형식=숫자(퍼센트 단위; 예: 2.0은 2%)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_FEE_RATE_PCT=0.02

# [KIS_SELL_TAX_RATE_PCT] 매도 순손익 추정에 추가할 세금/거래비용 비율(%)입니다.
# 상품·시장·세법에 따라 다를 수 있으므로 실제 적용 요율을 확인하세요.
# [설정 메타] 기본값=0.20; 허용값/형식=숫자(퍼센트 단위; 예: 2.0은 2%)
# [주의사항] 변경 후 설정 검증과 오프라인 회귀 테스트를 수행하세요.
KIS_SELL_TAX_RATE_PCT=0.20

