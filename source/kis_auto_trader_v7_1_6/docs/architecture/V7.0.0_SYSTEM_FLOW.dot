digraph KIS_V700 {
graph [rankdir=TB, bgcolor="#05090f", pad="0.25", nodesep="0.22", ranksep="0.42", splines=ortho, fontname="Noto Sans CJK KR", label="KIS Auto Trader V7.0.0 — 상세 시스템 흐름", labelloc=t, fontsize=22, fontcolor="white"];
