# KIS Auto Trader V7.1.6 systemd template. Install via scripts/start_monitoring.sh; do not use /path/to/project literally.
[Unit]
Description=Check KIS Auto Trader start every weekday at 08:00 KST

[Timer]
OnCalendar=Mon..Fri *-*-* 08:00:00 Asia/Seoul
Persistent=true
Unit=kis-auto-trader-start.service

[Install]
WantedBy=timers.target
